@model IEnumerable<ProyectoFinal.Models.User>
@{
    ViewData["Title"] = "User Management";
    var totalUsers = Model.Count();
    var admins = Model.Count(u => u.Role == "Admin");
    var workers = Model.Count(u => u.Role == "Worker");
    var clients = Model.Count(u => u.Role == "Client");
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">
            <i class="bi bi-people"></i> User Management
        </h1>
        <a asp-action="Create" class="btn-admin btn-admin-success">
            <i class="bi bi-person-plus"></i> Create User
        </a>
    </div>

    <!-- Stats Row -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon users">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-content">
                <h3>@totalUsers</h3>
                <p>Total Users</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon events">
                <i class="bi bi-shield-check"></i>
            </div>
            <div class="stat-content">
                <h3>@admins</h3>
                <p>Administrators</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon tickets">
                <i class="bi bi-person-badge"></i>
            </div>
            <div class="stat-content">
                <h3>@workers</h3>
                <p>Workers</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon revenue">
                <i class="bi bi-person-heart"></i>
            </div>
            <div class="stat-content">
                <h3>@clients</h3>
                <p>Clients</p>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="data-card">
        <div class="data-card-header">
            <h5><i class="bi bi-table me-2"></i> User List</h5>
            <span class="badge bg-light text-dark">@totalUsers registered</span>
        </div>
        <div class="data-card-body">
            @if (Model.Any())
            {
                <div class="table-container">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                
                                <th><i class="bi bi-person"></i> Username</th>
                                <th><i class="bi bi-envelope"></i> Email</th>
                                <th><i class="bi bi-shield"></i> Role</th>
                                <th><i class="bi bi-gear"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var roleClass = item.Role?.ToLower() ?? "client";
                                <tr>
                                   
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="user-avatar" style="width: 35px; height: 35px; font-size: 1rem;">
                                                <i class="bi bi-person"></i>
                                            </div>
                                            <span>@item.UserName</span>
                                        </div>
                                    </td>
                                    <td>@item.Email</td>
                                    <td>
                                        <span class="role-badge @roleClass">@item.Role</span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                           
                                          
                                            <a asp-action="Delete" asp-route-id="@item.UserId class="btn-admin btn-admin-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-people"></i>
                    <h4>No users registered</h4>
                    <p>Start by creating the first user</p>
                    <a asp-action="Create" class="btn-admin btn-admin-success mt-3">
                        <i class="bi bi-person-plus"></i> Create User
                    </a>
                </div>
            }
        </div>
    </div>
</div>
