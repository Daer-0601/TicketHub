@model ProyectoFinal.Models.User

@{
    ViewData["Title"] = "Create User";
}

<div class="container-fluid px-4">
    <div class="page-header">
        <h1 class="page-title">
            <i class="bi bi-person-plus"></i> Create User
        </h1>
        <a asp-action="Index" class="btn-admin btn-admin-outline">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="data-card">
                <div class="data-card-header">
                    <h5><i class="bi bi-person-badge me-2"></i> User Information</h5>
                </div>
                <div class="data-card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Please correct the following errors:</strong>
                            <ul class="mb-0 mt-2">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="alert alert-info" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Note:</strong> A temporary password will be automatically generated and sent to the user's email. 
                        The user will be required to change their password on first login.
                    </div>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">
                                <i class="bi bi-person me-1"></i> Username *
                            </label>
                            <input asp-for="UserName" class="form-control" placeholder="Enter username (letters, numbers, underscores)" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">
                                <i class="bi bi-envelope me-1"></i> Email Address *
                            </label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="user@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <small class="form-text text-muted">The temporary password will be sent to this email.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">
                                <i class="bi bi-shield me-1"></i> Role *
                            </label>
                            <select asp-for="Role" class="form-select">
                                <option value="">-- Select a role --</option>
                                <option value="Admin">Admin - Full system access</option>
                                <option value="Worker">Worker - Ticket scanning only</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <hr />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-person-plus-fill me-1"></i> Create User
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-lg me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="data-card">
                <div class="data-card-header">
                    <h5><i class="bi bi-info-circle me-2"></i> Role Information</h5>
                </div>
                <div class="data-card-body">
                    <div class="mb-4">
                        <h6><span class="badge bg-danger me-2">Admin</span> Administrator</h6>
                        <ul class="text-muted small">
                            <li>Full access to all system features</li>
                            <li>Manage events, sectors, and tickets</li>
                            <li>View sales reports and statistics</li>
                            <li>Create and manage users</li>
                        </ul>
                    </div>
                    
                    <div>
                        <h6><span class="badge bg-primary me-2">Worker</span> Worker</h6>
                        <ul class="text-muted small">
                            <li>Access to ticket scanning module only</li>
                            <li>Scan QR codes at event entrances</li>
                            <li>View scan history during shift</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
