@model IEnumerable<ProyectoFinal.Models.Event>
@{
    Layout = null;
    ViewData["Title"] = "Ticket Scanning";
    var userName = User.Identity?.Name ?? "Worker";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TicketHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --worker-primary: #e31837;
            --worker-secondary: #c41230;
            --worker-dark: #000000;
            --worker-success: #22c55e;
            --worker-danger: #ef4444;
            --worker-white: #ffffff;
            --worker-gray: #737373;
        }
        
        body {
            background: linear-gradient(180deg, #fafafa 0%, #fff 100%);
            min-height: 100vh;
        }
        
        /* Worker Navbar - Black and Red */
        .worker-navbar {
            background: var(--worker-dark);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
        }
        
        .worker-navbar .navbar-brand {
            font-weight: 700;
            font-size: 1.4rem;
            color: var(--worker-white) !important;
        }
        
        .worker-navbar .navbar-brand i {
            color: var(--worker-primary);
        }
        
        .user-badge {
            background: var(--worker-primary);
            padding: 0.5rem 1rem;
            border-radius: 30px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .user-badge i {
            font-size: 1.25rem;
        }
        
        /* Main Content */
        .worker-content {
            padding: 2rem;
        }
        
        .worker-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--worker-dark);
            margin-bottom: 0.5rem;
        }
        
        .worker-title i {
            color: var(--worker-primary);
        }
        
        .worker-subtitle {
            color: var(--worker-gray);
            margin-bottom: 2rem;
        }
        
        /* Cards */
        .worker-card {
            background: var(--worker-white);
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            overflow: hidden;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(0,0,0,0.05);
        }
        
        .worker-card-header {
            padding: 1rem 1.25rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .worker-card-header.primary {
            background: var(--worker-dark);
            color: var(--worker-white);
        }
        
        .worker-card-header.primary i {
            color: var(--worker-primary);
        }
        
        .worker-card-header.success {
            background: var(--worker-success);
            color: var(--worker-white);
        }
        
        .worker-card-header.secondary {
            background: var(--worker-dark);
            color: var(--worker-white);
        }
        
        .worker-card-body {
            padding: 1.5rem;
        }
        
        /* Scan Modes */
        .scan-mode-toggle {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
        }
        
        .scan-mode-btn {
            flex: 1;
            padding: 0.75rem 1rem;
            border: 2px solid #e5e5e5;
            background: var(--worker-white);
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            font-weight: 500;
        }
        
        .scan-mode-btn:hover {
            border-color: var(--worker-primary);
            color: var(--worker-primary);
        }
        
        .scan-mode-btn.active {
            background: var(--worker-primary);
            color: var(--worker-white);
            border-color: var(--worker-primary);
        }
        
        /* QR Reader */
        #qr-reader {
            border-radius: 12px;
            overflow: hidden;
        }
        
        /* Result Styles */
        .scan-result {
            text-align: center;
            padding: 3rem;
        }
        
        .scan-result-icon {
            font-size: 5rem;
            margin-bottom: 1rem;
        }
        
        .scan-result.valid .scan-result-icon { color: var(--worker-success); }
        .scan-result.invalid .scan-result-icon { color: var(--worker-danger); }
        .scan-result.warning .scan-result-icon { color: #eab308; }
        .scan-result.waiting .scan-result-icon { color: #e5e5e5; }
        
        .scan-result-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            color: var(--worker-dark);
        }
        
        .scan-result-message {
            color: var(--worker-gray);
        }
        
        .ticket-details {
            background: #fafafa;
            border-radius: 12px;
            padding: 1.25rem;
            margin-top: 1.5rem;
            text-align: left;
            border-left: 4px solid var(--worker-primary);
        }
        
        .ticket-details-row {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px solid #e5e5e5;
        }
        
        .ticket-details-row:last-child {
            border-bottom: none;
        }
        
        .ticket-details-label {
            color: var(--worker-gray);
            font-weight: 500;
        }
        
        .ticket-details-value {
            font-weight: 600;
            color: var(--worker-dark);
        }
        
        /* History */
        .history-item {
            display: flex;
            align-items: center;
            padding: 0.75rem;
            border-radius: 10px;
            margin-bottom: 0.5rem;
            background: #fafafa;
            transition: all 0.2s ease;
        }
        
        .history-item:hover {
            background: #f0f0f0;
        }
        
        .history-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 0.75rem;
            font-size: 1rem;
        }
        
        .history-icon.valid { background: rgba(34, 197, 94, 0.15); color: var(--worker-success); }
        .history-icon.invalid { background: rgba(239, 68, 68, 0.15); color: var(--worker-danger); }
        .history-icon.warning { background: rgba(234, 179, 8, 0.15); color: #eab308; }
        
        .history-content {
            flex: 1;
        }
        
        .history-message {
            font-weight: 500;
            font-size: 0.9rem;
            color: var(--worker-dark);
        }
        
        .history-time {
            font-size: 0.75rem;
            color: var(--worker-gray);
        }
        
        /* Info Box */
        .info-box {
            background: #fafafa;
            border-left: 4px solid var(--worker-primary);
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        
        .info-box strong {
            color: var(--worker-dark);
        }
        
        /* Buttons */
        .btn-worker {
            padding: 0.75rem 1.5rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }
        
        .btn-worker-primary {
            background: var(--worker-primary);
            color: var(--worker-white);
        }
        
        .btn-worker-primary:hover {
            background: var(--worker-secondary);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(227, 24, 55, 0.3);
        }
        
        .btn-worker-danger {
            background: var(--worker-danger);
            color: var(--worker-white);
        }
        
        .btn-worker-danger:hover {
            background: #dc2626;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
        }
        
        /* Footer */
        .worker-footer {
            background: var(--worker-dark);
            color: rgba(255,255,255,0.7);
            padding: 1rem;
            text-align: center;
            margin-top: auto;
        }
        
        .worker-footer i {
            color: var(--worker-primary);
        }
        
        /* Form Controls */
        .form-select:focus,
        .form-control:focus {
            border-color: var(--worker-primary);
            box-shadow: 0 0 0 0.2rem rgba(227, 24, 55, 0.25);
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Navbar -->
    <nav class="navbar navbar-dark worker-navbar">
        <div class="container-fluid px-4">
            <a class="navbar-brand" href="#">
                <i class="bi bi-qr-code-scan me-2"></i> TicketHub Scanner
            </a>
            <div class="d-flex align-items-center gap-3">
                <div class="user-badge text-white">
                    <i class="bi bi-person-circle"></i>
                    <span>@userName</span>
                </div>
                <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> Exit
                    </button>
                </form>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="worker-content flex-grow-1">
        <div class="container-fluid">
            <h1 class="worker-title"><i class="bi bi-upc-scan me-2"></i> Ticket Scanning</h1>
            <p class="worker-subtitle">Select an event and sector, then scan the QR codes of the tickets.</p>

            <div class="row">
                <!-- Configuration Panel -->
                <div class="col-lg-4">
                    <div class="worker-card">
                        <div class="worker-card-header primary">
                            <i class="bi bi-sliders"></i> Configuration
                        </div>
                        <div class="worker-card-body">
                            <div class="mb-3">
                                <label for="eventSelect" class="form-label fw-semibold">
                                    <i class="bi bi-calendar-event me-1" style="color: #e31837;"></i> Event
                                </label>
                                <select id="eventSelect" class="form-select">
                                    <option value="">-- Select an event --</option>
                                    @foreach (var evento in Model)
                                    {
                                        <option value="@evento.EventId" data-name="@evento.Name">
                                            @evento.Name - @evento.Date.ToString("MM/dd/yyyy")
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="sectorSelect" class="form-label fw-semibold">
                                    <i class="bi bi-grid-3x3-gap me-1" style="color: #e31837;"></i> Sector
                                </label>
                                <select id="sectorSelect" class="form-select" disabled>
                                    <option value="">-- First select an event --</option>
                                </select>
                            </div>

                            <div class="info-box">
                                <div><strong>Event:</strong> <span id="selectedEventName">None</span></div>
                                <div><strong>Sector:</strong> <span id="selectedSectorName">None</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- Scanning Area -->
                    <div class="worker-card">
                        <div class="worker-card-header success">
                            <i class="bi bi-qr-code"></i> Scan QR
                        </div>
                        <div class="worker-card-body">
                            <!-- Mode Toggle -->
                            <div class="scan-mode-toggle">
                                <button type="button" class="scan-mode-btn active" id="cameraModeBtn">
                                    <i class="bi bi-camera-video"></i> Camera
                                </button>
                               
                            </div>

                            <!-- Camera Mode -->
                            <div id="cameraSection">
                                <div id="qr-reader"></div>
                                <div id="qr-reader-results" class="alert alert-info mt-3" style="display: none;"></div>
                                <button id="stopCameraBtn" class="btn-worker btn-worker-danger w-100 mt-3" style="display: none;">
                                    <i class="bi bi-camera-video-off me-1"></i> Stop Camera
                                </button>
                            </div>

                         
                        </div>
                    </div>
                </div>

                <!-- Results Panel -->
                <div class="col-lg-8">
                    <div class="worker-card">
                        <div class="worker-card-header secondary">
                            <i class="bi bi-check2-circle"></i> Scan Result
                        </div>
                        <div class="worker-card-body">
                            <div id="resultArea" class="scan-result waiting">
                                <div class="scan-result-icon">
                                    <i class="bi bi-qr-code"></i>
                                </div>
                                <h3 class="scan-result-title">Waiting for scan</h3>
                                <p class="scan-result-message">Configure the event and sector, then scan a QR code</p>
                            </div>
                        </div>
                    </div>

                    <!-- History -->
                    <div class="worker-card">
                        <div class="worker-card-header secondary">
                            <i class="bi bi-clock-history"></i> Recent Scans
                        </div>
                        <div class="worker-card-body">
                            <div id="scanHistory">
                                <p class="text-muted text-center py-3">No recent scans</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="worker-footer">
        <i class="bi bi-ticket-perforated me-1"></i> TicketHub Scanner © 2025
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>
    <script>
        let scanHistory = [];
        let html5QrCode = null;
        let isScanning = false;

        // Toggle modes
        $('#cameraModeBtn').on('click', function() {
            $(this).addClass('active');
            $('#manualModeBtn').removeClass('active');
            $('#cameraSection').show();
            $('#manualSection').hide();
            if ($('#eventSelect').val() && $('#sectorSelect').val()) {
                startCameraScanner();
            }
        });

        $('#manualModeBtn').on('click', function() {
            $(this).addClass('active');
            $('#cameraModeBtn').removeClass('active');
            $('#cameraSection').hide();
            $('#manualSection').show();
            stopCameraScanner();
        });

        // Initialize scanner
        function startCameraScanner() {
            if (isScanning) return;
            
            const eventId = $('#eventSelect').val();
            const sectorId = $('#sectorSelect').val();
            
            if (!eventId || !sectorId) {
                $('#qr-reader-results').html('<div class="alert alert-warning mb-0">Select event and sector first</div>').show();
                return;
            }

            html5QrCode = new Html5Qrcode("qr-reader");
            isScanning = true;
            $('#stopCameraBtn').show();

            html5QrCode.start(
                { facingMode: "environment" },
                { fps: 10, qrbox: { width: 250, height: 250 } },
                (decodedText) => handleScannedCode(decodedText),
                () => {}
            ).catch((err) => {
                console.error("Camera error:", err);
                $('#qr-reader-results').html(
                    '<div class="alert alert-danger mb-0">Error accessing camera. Use manual mode.</div>'
                ).show();
                isScanning = false;
                $('#stopCameraBtn').hide();
            });
        }

        function stopCameraScanner() {
            if (html5QrCode && isScanning) {
                html5QrCode.stop().then(() => {
                    html5QrCode.clear();
                    isScanning = false;
                    $('#stopCameraBtn').hide();
                    $('#qr-reader-results').hide();
                }).catch(console.error);
            }
        }

        $('#stopCameraBtn').on('click', function() {
            stopCameraScanner();
            $('#manualModeBtn').click();
        });

        function handleScannedCode(qrCode) {
            if (!isScanning) return;
            stopCameraScanner();
            processScan(qrCode, $('#eventSelect').val(), $('#sectorSelect').val());
        }

        // Load sectors
        $('#eventSelect').on('change', function() {
            if (isScanning) stopCameraScanner();
            
            const eventId = $(this).val();
            const eventName = $(this).find('option:selected').data('name') || 'None';
            
            $('#selectedEventName').text(eventName);
            $('#sectorSelect').prop('disabled', !eventId).html('<option value="">Loading...</option>');

            if (eventId) {
                $.get('/Workers/GetSectors', { eventId: eventId }, function(sectors) {
                    let options = '<option value="">-- Select sector --</option>';
                    sectors.forEach(s => options += `<option value="${s.sectorId}">${s.name}</option>`);
                    $('#sectorSelect').html(options);
                });
            } else {
                $('#sectorSelect').html('<option value="">-- First select an event --</option>');
                $('#selectedSectorName').text('None');
            }
        });

        $('#sectorSelect').on('change', function() {
            const sectorName = $(this).find('option:selected').text();
            $('#selectedSectorName').text(sectorName.includes('--') ? 'None' : sectorName);
            updateScanButton();
            
            if ($('#cameraModeBtn').hasClass('active') && $('#eventSelect').val() && $(this).val()) {
                if (!isScanning) startCameraScanner();
            }
        });

        function updateScanButton() {
            const canScan = $('#eventSelect').val() && $('#sectorSelect').val() && $('#qrInput').val().trim();
            $('#scanButton').prop('disabled', !canScan);
        }

        $('#qrInput').on('input', updateScanButton);
        
        $('#qrInput').on('keypress', function(e) {
            if (e.which === 13 && !$('#scanButton').prop('disabled')) {
                processScan($('#qrInput').val().trim(), $('#eventSelect').val(), $('#sectorSelect').val());
            }
        });

        $('#scanButton').on('click', function() {
            processScan($('#qrInput').val().trim(), $('#eventSelect').val(), $('#sectorSelect').val());
        });

        function processScan(qrCode, eventId, sectorId) {
            if (!qrCode || !eventId || !sectorId) {
                showResult('invalid', 'Complete all fields', null);
                return;
            }

            $('#scanButton').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Verifying...');

            $.ajax({
                url: '/Workers/Scan',
                method: 'POST',
                data: { qrCode, eventId, sectorId },
                success: function(response) {
                    showResult(response.status, response.message, response.ticketInfo);
                    addToHistory(response);
                    $('#qrInput').val('').focus();
                    
                    if ($('#cameraModeBtn').hasClass('active')) {
                        setTimeout(() => {
                            if ($('#eventSelect').val() && $('#sectorSelect').val()) startCameraScanner();
                        }, 2000);
                    }
                    updateScanButton();
                },
                error: function(xhr) {
                    const response = xhr.responseJSON || { message: 'Connection error', status: 'error' };
                    showResult(response.status, response.message, response.ticketInfo);
                    
                    if ($('#cameraModeBtn').hasClass('active')) {
                        setTimeout(() => {
                            if ($('#eventSelect').val() && $('#sectorSelect').val()) startCameraScanner();
                        }, 2000);
                    }
                    updateScanButton();
                }
            });
        }

        function showResult(status, message, ticketInfo) {
            let resultClass = 'waiting';
            let icon = 'bi-qr-code';
            let title = 'Result';

            switch(status) {
                case 'valid':
                    resultClass = 'valid';
                    icon = 'bi-check-circle-fill';
                    title = '✓ Valid Ticket';
                    break;
                case 'alreadyscanned':
                case 'wrongsector':
                    resultClass = 'warning';
                    icon = 'bi-exclamation-triangle-fill';
                    title = status === 'alreadyscanned' ? '⚠ Already Scanned' : '⚠ Wrong Sector';
                    break;
                default:
                    resultClass = 'invalid';
                    icon = 'bi-x-circle-fill';
                    title = '✗ Invalid Ticket';
            }

            let html = `
                <div class="scan-result ${resultClass}">
                    <div class="scan-result-icon"><i class="bi ${icon}"></i></div>
                    <h3 class="scan-result-title">${title}</h3>
                    <p class="scan-result-message">${message}</p>
            `;

            if (ticketInfo) {
                html += `<div class="ticket-details">`;
                if (ticketInfo.ticketId) html += `<div class="ticket-details-row"><span class="ticket-details-label">Ticket ID</span><span class="ticket-details-value">#${ticketInfo.ticketId}</span></div>`;
                if (ticketInfo.eventName) html += `<div class="ticket-details-row"><span class="ticket-details-label">Event</span><span class="ticket-details-value">${ticketInfo.eventName}</span></div>`;
                if (ticketInfo.sectorName) html += `<div class="ticket-details-row"><span class="ticket-details-label">Sector</span><span class="ticket-details-value">${ticketInfo.sectorName}</span></div>`;
                if (ticketInfo.price) html += `<div class="ticket-details-row"><span class="ticket-details-label">Price</span><span class="ticket-details-value">$${ticketInfo.price.toFixed(2)}</span></div>`;
                if (ticketInfo.scannedAt) html += `<div class="ticket-details-row"><span class="ticket-details-label">Scanned</span><span class="ticket-details-value">${new Date(ticketInfo.scannedAt).toLocaleString('en-US')}</span></div>`;
                html += `</div>`;
            }

            html += `</div>`;
            $('#resultArea').html(html);
        }

        function addToHistory(response) {
            scanHistory.unshift({
                timestamp: new Date(),
                status: response.status,
                message: response.message,
                ticketInfo: response.ticketInfo || {}
            });
            if (scanHistory.length > 10) scanHistory.pop();
            updateHistoryDisplay();
        }

        function updateHistoryDisplay() {
            if (scanHistory.length === 0) {
                $('#scanHistory').html('<p class="text-muted text-center py-3">No recent scans</p>');
                return;
            }

            let html = '';
            scanHistory.forEach(item => {
                let iconClass = 'invalid';
                let icon = 'bi-x-circle';
                
                if (item.status === 'valid') { iconClass = 'valid'; icon = 'bi-check-circle'; }
                else if (['alreadyscanned', 'wrongsector'].includes(item.status)) { iconClass = 'warning'; icon = 'bi-exclamation-triangle'; }

                html += `
                    <div class="history-item">
                        <div class="history-icon ${iconClass}"><i class="bi ${icon}"></i></div>
                        <div class="history-content">
                            <div class="history-message">${item.message}</div>
                            <div class="history-time">${item.timestamp.toLocaleTimeString('en-US')}${item.ticketInfo.ticketId ? ` - Ticket #${item.ticketInfo.ticketId}` : ''}</div>
                        </div>
                    </div>
                `;
            });
            $('#scanHistory').html(html);
        }
    </script>
</body>
</html>
