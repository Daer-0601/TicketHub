<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TicketHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/client-events.css" asp-append-version="true" />
    <style>
        /* Client Navbar - Black, Red, White */
        .client-navbar {
            background: #000000;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
        }
        
        .client-navbar .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            color: #fff !important;
        }
        
        .client-navbar .navbar-brand i {
            color: #e31837;
        }
        
        .client-navbar .nav-link {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 500;
            padding: 0.6rem 1rem;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        
        .client-navbar .nav-link:hover {
            color: #fff !important;
            background-color: #e31837;
        }
        
        .client-navbar .nav-link.active {
            background: #e31837;
            color: #fff !important;
        }
        
        .client-user-menu {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        
        .client-user-avatar {
            width: 40px;
            height: 40px;
            background: #e31837;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.1rem;
        }
        
        .client-user-name {
            color: #fff;
            font-weight: 500;
        }
        
        .dropdown-menu {
            border: none;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            border-radius: 12px;
            border-top: 3px solid #e31837;
        }
        
        body {
            padding-top: 70px;
        }
        
        /* Client Footer - Black, Red, White */
        .client-footer {
            background: #000000;
            color: #fff;
            padding: 3rem 0 1.5rem;
            margin-top: 0;
        }
        
        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
        }
        
        .footer-section h5 {
            color: #e31837;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        
        .footer-section ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }
        
        .footer-section ul li {
            margin-bottom: 0.5rem;
        }
        
        .footer-section ul li a {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            transition: color 0.3s ease;
        }
        
        .footer-section ul li a:hover {
            color: #e31837;
        }
        
        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.1);
            padding-top: 1.5rem;
            text-align: center;
            color: rgba(255,255,255,0.6);
        }
        
        .social-links {
            display: flex;
            gap: 1rem;
            margin-top: 1rem;
        }
        
        .social-links a {
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            transition: all 0.3s ease;
        }
        
        .social-links a:hover {
            background: #e31837;
            transform: translateY(-3px);
        }
        
        .btn-outline-light:hover {
            background: #e31837;
            border-color: #e31837;
        }
        
        .btn-danger {
            background: #e31837;
            border-color: #e31837;
        }
        
        .btn-danger:hover {
            background: #c41230;
            border-color: #c41230;
        }
    </style>
</head>
<body>
    @{
        var userName = User.Identity?.Name ?? "User";
        var isAuthenticated = User.Identity?.IsAuthenticated == true;
    }

    <!-- Client Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark client-navbar">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-ticket-perforated-fill me-2"></i>TicketHub
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#clientNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="clientNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                           asp-controller="ClientEvents" asp-action="Index">
                            <i class="bi bi-calendar-heart me-1"></i> Events
                        </a>
                    </li>
                </ul>
                
                @if (isAuthenticated)
                {
                    <div class="client-user-menu">
                        <div class="dropdown">
                            <a class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle" 
                               href="#" id="userDropdown" data-bs-toggle="dropdown">
                                <div class="client-user-avatar">
                                    <i class="bi bi-person"></i>
                                </div>
                                <span class="client-user-name d-none d-md-inline">@userName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li class="dropdown-header">
                                    <strong>@userName</strong>
                                    <br><small class="text-muted">Client</small>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Login" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Log Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <a asp-controller="Login" asp-action="Index" class="btn btn-outline-light">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                        </a>
                        <a asp-controller="Login" asp-action="Register" class="btn btn-danger">
                            <i class="bi bi-person-plus me-1"></i> Sign Up
                        </a>
                    </div>
                }
            </div>
        </div>
    </nav>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- Main Content -->
    <main>
        @RenderBody()
    </main>

    <!-- Client Footer -->
    <footer class="client-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-section">
                    <h5><i class="bi bi-ticket-perforated me-2"></i>TicketHub</h5>
                    <p style="color: rgba(255,255,255,0.7);">
                        Your trusted platform for buying tickets to the best events.
                    </p>
                   
                </div>
              
              
                <div class="footer-section">
                    <h5>Contact</h5>
                    <ul>
                        <li><i class="bi bi-envelope me-2"></i>TicketHubsupport@gmail.com</li>
                        <li><i class="bi bi-telephone me-2"></i>+591 69500556</li>
                        <li><i class="bi bi-geo-alt me-2"></i>Bolivia</li>
                    </ul>   
                </div>
            </div>
            <div class="footer-bottom">
                <p class="mb-0">&copy; 2025 TicketHub. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
