@model ProyectoFinal.Models.Event
@{
    ViewData["Title"] = "Delete Event";
}

<h1>Delete Event</h1>

<div class="card mb-3">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="card-img-top" style="height:200px; object-fit:cover;" />
    }
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text">
            <strong>Date:</strong> @Model.Date.ToString("yyyy-MM-dd") <br />
            <strong>Time:</strong> @Model.Time.ToString(@"hh\:mm") <br />
            <strong>Location:</strong> @Model.Location
        </p>
        <p>
            <strong>Sectors:</strong>
            @if (Model.Sectors != null && Model.Sectors.Any())
            {
                <ul>
                    @foreach (var s in Model.Sectors)
                    {
                        <li>@s.Name - $@s.Price - Capacity: @s.Capacity</li>
                    }
                </ul>
            }
            else
            {
                <span>No sectors</span>
            }
        </p>
    </div>
</div>

<form asp-action="Delete" method="post"
      onsubmit="return confirm('Are you sure you want to delete this event?');">
    <input type="hidden" asp-for="EventId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
