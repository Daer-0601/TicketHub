@model ProyectoFinal.Models.Event
@{
    ViewData["Title"] = "Report - " + Model.Name;
    var totalTickets = Model.Tickets?.Count ?? 0;
    var scannedTickets = Model.Tickets?.Count(t => t.ScannedAt != null) ?? 0;
    var pendingTickets = totalTickets - scannedTickets;
    var totalRevenue = Model.Tickets?.Sum(t => t.Price) ?? 0;
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-graph-up"></i> @Model.Name
            </h1>
            <p class="text-muted mb-0">
                <i class="bi bi-calendar3 me-1"></i> @Model.Date.ToString("dddd, dd MMMM yyyy", new System.Globalization.CultureInfo("en-US"))
                <span class="mx-2">|</span>
                <i class="bi bi-clock me-1"></i> @Model.Time.ToString(@"hh\:mm") hrs
                <span class="mx-2">|</span>
                <i class="bi bi-geo-alt me-1"></i> @Model.Location
            </p>
        </div>
        <a asp-action="Reports" class="btn-admin btn-admin-outline">
            <i class="bi bi-arrow-left"></i> Back to Reports
        </a>
    </div>

    <!-- Event Stats -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon" style="background: #e31837;">
                <i class="bi bi-ticket-perforated-fill"></i>
            </div>
            <div class="stat-content">
                <h3>@totalTickets</h3>
                <p>Tickets Sold</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #22c55e;">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div class="stat-content">
                <h3>@scannedTickets</h3>
                <p>People Entered</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #eab308;">
                <i class="bi bi-hourglass-split"></i>
            </div>
            <div class="stat-content">
                <h3>@pendingTickets</h3>
                <p>Pending</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #000;">
                <i class="bi bi-cash-stack"></i>
            </div>
            <div class="stat-content">
                <h3>$@totalRevenue.ToString("N0")</h3>
                <p>Total Revenue</p>
            </div>
        </div>
    </div>

    <!-- Sales by Sector -->
    <div class="data-card">
        <div class="data-card-header">
            <h5><i class="bi bi-grid-3x3-gap me-2"></i> Sales by Sector</h5>
        </div>
        <div class="data-card-body">
            @if (Model.Sectors != null && Model.Sectors.Any())
            {
                <div class="row">
                    @foreach (var sector in Model.Sectors)
                    {
                        var sectorTickets = Model.Tickets?.Count(t => t.SectorId == sector.SectorId) ?? 0;
                        var sectorScanned = Model.Tickets?.Count(t => t.SectorId == sector.SectorId && t.ScannedAt != null) ?? 0;
                        var sectorRevenue = Model.Tickets?.Where(t => t.SectorId == sector.SectorId).Sum(t => t.Price) ?? 0;
                        var sectorPercentage = sector.Capacity > 0 ? (sectorTickets * 100.0 / sector.Capacity) : 0;
                        var sectorScanPercentage = sectorTickets > 0 ? (sectorScanned * 100.0 / sectorTickets) : 0;
                        
                        <div class="col-lg-6 col-xl-4 mb-3">
                            <div class="sector-item p-3 rounded" style="background: #fafafa; border-left: 4px solid #e31837; height: 100%;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div>
                                        <strong>@sector.Name</strong>
                                        <span class="badge ms-2" style="background: #000; color: #fff;">$@sector.Price.ToString("N0")</span>
                                    </div>
                                    <span class="fw-bold" style="color: #22c55e;">$@sectorRevenue.ToString("N0")</span>
                                </div>
                                
                                <div class="row text-center mb-2" style="font-size: 0.85rem;">
                                    <div class="col-4">
                                        <div class="fw-bold" style="color: #e31837;">@sectorTickets</div>
                                        <small class="text-muted">Sold</small>
                                    </div>
                                    <div class="col-4">
                                        <div class="fw-bold" style="color: #22c55e;">@sectorScanned</div>
                                        <small class="text-muted">Entered</small>
                                    </div>
                                    <div class="col-4">
                                        <div class="fw-bold">@sector.Capacity</div>
                                        <small class="text-muted">Capacity</small>
                                    </div>
                                </div>
                                
                                <div class="mb-1">
                                    <small class="text-muted">Occupancy: @sectorPercentage.ToString("F0")%</small>
                                </div>
                                <div class="progress" style="height: 8px; border-radius: 4px; background: #e5e5e5;">
                                    <div class="progress-bar" style="width: @sectorPercentage%; background: #e31837; border-radius: 4px;"></div>
                                </div>
                                
                                <div class="mt-2 mb-1">
                                    <small class="text-muted">Entry: @sectorScanPercentage.ToString("F0")%</small>
                                </div>
                                <div class="progress" style="height: 8px; border-radius: 4px; background: #e5e5e5;">
                                    <div class="progress-bar" style="width: @sectorScanPercentage%; background: #22c55e; border-radius: 4px;"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-grid-3x3" style="font-size: 3rem;"></i>
                    <p class="mt-2">No sectors configured</p>
                </div>
            }
        </div>
    </div>
</div>
