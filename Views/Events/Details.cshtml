@model ProyectoFinal.Models.Event
@{
    ViewData["Title"] = "Detalles del Evento";
}

<h1>Detalles del Evento</h1>

<div class="card mb-3">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="card-img-top" style="height:250px; object-fit:cover;" />
    }
    <div class="card-body">
        <h3 class="card-title">@Model.Name</h3>
        <p class="card-text">
            <strong>Fecha:</strong> @Model.Date.ToString("yyyy-MM-dd") <br />
            <strong>Hora:</strong> @Model.Time.ToString(@"hh\:mm") <br />
            <strong>Ubicación:</strong> @Model.Location
        </p>

        <h5>Sectores</h5>
        @if (Model.Sectors != null && Model.Sectors.Any())
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Precio</th>
                        <th>Capacidad</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sector in Model.Sectors)
                    {
                        <tr>
                            <td>@sector.Name</td>
                            <td>$@sector.Price</td>
                            <td>@sector.Capacity</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No hay sectores registrados.</p>
        }
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-warning">Editar</a>
<a asp-action="Delete" asp-route-id="@Model.EventId" class="btn btn-danger">Eliminar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
