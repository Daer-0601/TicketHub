@model ProyectoFinal.Models.Event
@{
    ViewData["Title"] = "Event Details";
}

<h1>Event Details</h1>

<div class="card mb-3">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" class="card-img-top" style="height:250px; object-fit:cover;" />
    }
    <div class="card-body">
        <h3 class="card-title">@Model.Name</h3>
        <p class="card-text">
            <strong>Date:</strong> @Model.Date.ToString("yyyy-MM-dd") <br />
            <strong>Time:</strong> @Model.Time.ToString(@"hh\:mm") <br />
            <strong>Location:</strong> @Model.Location
        </p>

        <h5>Sectors</h5>
        @if (Model.Sectors != null && Model.Sectors.Any())
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Capacity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sector in Model.Sectors)
                    {
                        <tr>
                            <td>@sector.Name</td>
                            <td>$@sector.Price</td>
                            <td>@sector.Capacity</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No sectors registered.</p>
        }
    </div>
</div>


<a asp-action="Index" class="btn btn-secondary">Back</a>
