@model IEnumerable<ProyectoFinal.Models.Event>
@{
    ViewData["Title"] = "Event Management";
    var totalEvents = Model.Count();
    var upcomingEvents = Model.Count(e => e.Date >= DateTime.Today);
}

<div class="container-fluid px-4">
    <!-- Page Header -->
    <div class="page-header">
        <h1 class="page-title">
            <i class="bi bi-calendar-event"></i> Event Management
        </h1>
        <div class="d-flex gap-2">
            <a asp-action="Reports" class="btn-admin btn-admin-info">
                <i class="bi bi-bar-chart-fill"></i> View Reports
            </a>
            <a asp-action="Create" class="btn-admin btn-admin-success">
                <i class="bi bi-plus-lg"></i> Create New Event
            </a>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon events">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div class="stat-content">
                <h3>@totalEvents</h3>
                <p>Total Events</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon tickets">
                <i class="bi bi-calendar-plus"></i>
            </div>
            <div class="stat-content">
                <h3>@upcomingEvents</h3>
                <p>Upcoming Events</p>
            </div>
        </div>
    </div>

    <!-- Events Grid -->
    @if (Model.Any())
    {
        <div class="events-admin-grid">
            @foreach (var item in Model.OrderByDescending(e => e.Date))
            {
                var isPast = item.Date < DateTime.Today;
                <div class="event-admin-card">
                    <div class="event-admin-image">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" />
                        }
                        else
                        {
                            <img src="https://via.placeholder.com/400x180/1a1a2e/ffffff?text=@item.Name" alt="@item.Name" />
                        }
                        <span class="event-admin-badge">
                            @(isPast ? "Finished" : "Active")
                        </span>
                    </div>
                    
                    <div class="event-admin-body">
                        <h5 class="event-admin-title">@item.Name</h5>
                        
                        <div class="event-admin-info">
                            <span><i class="bi bi-calendar3"></i> @item.Date.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("en-US"))</span>
                            <span><i class="bi bi-clock"></i> @item.Time.ToString(@"hh\:mm") hrs</span>
                            <span><i class="bi bi-geo-alt"></i> @item.Location</span>
                        </div>
                        
                        <div class="event-admin-sectors">
                            <h6><i class="bi bi-grid-3x3-gap"></i> Sectors</h6>
                            @if (item.Sectors != null && item.Sectors.Any())
                            {
                                <ul class="sector-list">
                                    @foreach (var s in item.Sectors.Take(3))
                                    {
                                        <li>
                                            <span>@s.Name (Cap: @s.Capacity)</span>
                                            <span class="sector-price">$@s.Price.ToString("N0")</span>
                                        </li>
                                    }
                                    @if (item.Sectors.Count > 3)
                                    {
                                        <li class="text-muted">+ @(item.Sectors.Count - 3) more...</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <span class="text-muted" style="font-size: 0.85rem;">No sectors configured</span>
                            }
                        </div>
                        
                        <div class="event-admin-actions">
                            <a asp-action="Details" asp-route-id="@item.EventId" class="btn-admin btn-admin-info">
                                <i class="bi bi-eye"></i> View
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.EventId" class="btn-admin btn-admin-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.EventId" class="btn-admin btn-admin-danger">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="data-card">
            <div class="data-card-body">
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <h4>No events registered</h4>
                    <p>Start by creating your first event</p>
                   
                        
                  
                </div>
            </div>
        </div>
    }
</div>
