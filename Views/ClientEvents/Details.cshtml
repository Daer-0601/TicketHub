@model ProyectoFinal.Models.Event
@{
    var availability = ViewBag.Disponibilidad as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<h2>@Model.Name</h2>

<div class="row">
    <div class="col-md-6">
        <img src="@Model.ImageUrl" class="img-fluid rounded">
    </div>

    <div class="col-md-6">
        <h4>Select your tickets</h4>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-action="Buy" method="post">
            <input type="hidden" name="eventId" value="@Model.EventId">

            <div class="mb-3">
                <label>Email where you will receive the tickets</label>
                <input type="email" name="email" required class="form-control" />
            </div>

            @foreach (var s in Model.Sectors)
            {
                int availableTickets = availability.ContainsKey(s.SectorId) ? availability[s.SectorId] : s.Capacity;
                bool soldOut = availableTickets <= 0;

                <div class="card p-3 mb-2 @(soldOut ? "bg-light" : "")">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@s.Name ($@s.Price)</h5>
                        @if (soldOut)
                        {
                            <span class="badge bg-danger">SOLD OUT</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@availableTickets available</span>
                        }
                    </div>
                    <label class="mt-2">Quantity:</label>
                    <input type="number" 
                           min="0" 
                           max="@availableTickets" 
                           value="0" 
                           name="cantidades[@s.SectorId]" 
                           class="form-control" 
                           @(soldOut ? "disabled" : "") />
                </div>
            }

            <button class="btn btn-success mt-3">Buy</button>
        </form>
    </div>
</div>
